# ── App ──────────────────────────────────────────────
APP_ENV=local
APP_DEBUG=true

# ── Database ─────────────────────────────────────────
# RichLink 자신의 "수집함(staging)" DB. 홈해버 DB와는 반드시 별개의
# Supabase 프로젝트를 써야 한다 (직접 연결 금지 규칙은 홈해버 쪽에만 해당).
DATABASE_URL=postgresql+asyncpg://richlink:richlink@localhost:5432/richlink
DATABASE_ECHO=false

# ── Redis (Celery로 셀프 호스팅할 때만 필요. GitHub Actions만 쓰면 비워둬도 됨) ──
REDIS_URL=redis://localhost:6379/0

# ── 홈해버 등록 API ────────────────────────────────────
# 직접 DB에 연결하지 않고, 이 API로만 데이터를 전달한다.
HOMEHAVER_API_URL=https://www.homehaber.com/api/crawler/listings
HOMEHAVER_API_TOKEN=
HOMEHAVER_API_BATCH_SIZE=50

# ── 어드민 화면(/admin) 보호용 토큰 ───────────────────────
# 비워두면 어드민 API/화면 전체가 막힌다(안전을 위한 기본값).
# 직접 아무 문자열이나 정해서 넣으면 된다 (예: openssl rand -hex 16 로 생성).
ADMIN_TOKEN=

# ── Crawling ─────────────────────────────────────────
MAX_CONCURRENT_SPIDERS=20
REQUEST_TIMEOUT_SECONDS=30
PLAYWRIGHT_HEADLESS=true

# ── AI (아직 미구현 — 향후 교통/학군/개발호재 자동 요약용) ──────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── 중복 판단 (RichLink 자신의 수집함 안에서만 비교) ──────────
DUPLICATE_SIMILARITY_THRESHOLD=0.90
